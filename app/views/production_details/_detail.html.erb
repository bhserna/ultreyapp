<section class="page__section" aria-labelledby="production-detail-heading">
  <h2 id="production-detail-heading">Detalles de producción</h2>

  <% if (production_detail = @activity.production_detail) %>
    <% {
      "Ejecuta" => @activity.executors,
      "Pantalla" => production_detail.screen,
      "Audio" => production_detail.audio,
      "Iluminación de sala" => production_detail.room_lighting,
      "Iluminación de escenario" => production_detail.stage_lighting,
      "Iluminación de pasillos" => production_detail.aisle_lighting,
      "Requerimientos" => production_detail.requirements,
      "Notas" => @activity.notes,
      "Radios" => production_detail.radios,
      "Pendientes por confirmar" => @activity.pending_confirmations
    }.each do |label, value| %>
      <h3><%= label %></h3>
      <%= simple_format(value.presence || "—") %>
    <% end %>

    <div class="questions__actions">
      <%= link_to "Editar detalles de producción", edit_schedule_entry_production_detail_path(@activity.id) %>
    </div>
  <% else %>
    <p>Todavía no hay detalles de producción para esta actividad.</p>
    <%= link_to "Agregar detalles de producción", new_schedule_entry_production_detail_path(@activity.id), class: "page__action" %>
  <% end %>
</section>
