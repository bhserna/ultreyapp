<% content_for :title, @schedule_entry ? "Responder · #{@schedule_entry.activity}" : "Responder pregunta general" %>

<main class="activity-page">
  <%= link_to "← Volver a las preguntas", questions_collection_path(schedule_entry: @schedule_entry, topic: @question.topic), class: "activity-page__back" %>

  <header class="activity-page__header">
    <% if @schedule_entry %>
      <p class="activity-page__eyebrow"><%= @schedule_entry.day %> · <%= @schedule_entry.activity %></p>
    <% end %>
    <h1><%= @question.answer.present? ? "Editar respuesta" : "Responder" %></h1>
  </header>

  <section class="activity-page__section">
    <%= turbo_frame_tag dom_id(@question) do %>
      <p class="questions__body"><%= @question.body %></p>

      <%= form_with model: @question,
            url: question_answer_path(@question),
            method: :patch, class: "questions__form" do |form| %>
        <%= form.label :answer, "Respuesta" %>
        <%= form.text_area :answer, rows: 1, required: true, class: "questions__answer-input",
              data: { controller: "autosize", action: "input->autosize#resize" } %>
        <div class="questions__form-actions">
          <%= form.submit "Guardar respuesta" %>
          <%= link_to "Cancelar", questions_collection_path(schedule_entry: @schedule_entry, topic: @question.topic), class: "questions__cancel" %>
        </div>
      <% end %>
    <% end %>
  </section>
</main>
