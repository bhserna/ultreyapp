<%= turbo_frame_tag dom_id(topic) do %>
  <p class="topics__name"><%= topic.name %></p>
  <div class="questions__actions">
    <%= link_to "Editar", edit_topic_path(topic), aria: { label: "Editar tema #{topic.name}" } %>
    <%= button_to "Eliminar", topic_path(topic), method: :delete,
          form: { data: { turbo_confirm: "¿Eliminar el tema #{topic.name}? Sus preguntas quedarán sin tema.", turbo_frame: "_top" } },
          aria: { label: "Eliminar tema #{topic.name}" }, class: "activity-page__action" %>
  </div>
<% end %>
