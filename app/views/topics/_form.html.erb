<%= form_with model: topic, url: url, method: method, class: "questions__form" do |form| %>
  <%= form.label :name, "Nombre" %>
  <%= form.text_field :name, required: true %>
  <div class="questions__form-actions">
    <%= form.submit submit_label %>
    <% if local_assigns[:cancel_action] %>
      <%= button_tag "Cancelar", type: "button", class: "questions__cancel", data: { action: cancel_action } %>
    <% elsif local_assigns[:cancel_url] %>
      <%= link_to "Cancelar", cancel_url, class: "questions__cancel" %>
    <% end %>
  </div>
<% end %>
