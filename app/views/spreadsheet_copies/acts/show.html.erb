<% content_for :title, @act.title %>

<main class="page">
  <%= link_to "← Volver al programa", spreadsheet_copy_day_path(@spreadsheet_copy, @act.day, row_type: @selected_row_type), class: "page__back" %>

  <header class="page__header">
    <p class="page__eyebrow"><%= @act.day %></p>
    <h1><%= @act.title %></h1>
    <dl class="page__details">
      <% if @act.number.present? %>
        <div><dt>Acto</dt><dd><%= @act.number %></dd></div>
      <% end %>
      <div><dt>Horario</dt><dd><%= @act.schedule.to_s.presence || "—" %></dd></div>
    </dl>
    <p>Copia descargada el <%= time_tag @spreadsheet_copy.created_at, l(@spreadsheet_copy.created_at, format: :spreadsheet_copy, locale: :es) %>.</p>
  </header>

  <% details = spreadsheet_act_detail_fields.select { |attribute, label| @act.public_send(attribute).present? } %>
  <% if details.any? %>
    <section class="page__section" aria-label="Detalles de la actividad">
      <%= render "shared/spreadsheet_entry_details", entry: @act, fields: details %>
    </section>
  <% end %>

  <%= turbo_frame_tag "documents", src: spreadsheet_copy_day_act_documents_path(@spreadsheet_copy, @act.day, @act, row_type: @selected_row_type) do %>
    <p class="documents__empty">Cargando documentos…</p>
  <% end %>
</main>
