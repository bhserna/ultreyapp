<% content_for :title, "Programa actualizado" %>

<main class="page page--wide">
  <header class="page__header page__header--flush">
    <h1>Programa actualizado</h1>
    <p>Copia descargada el <%= time_tag @spreadsheet_copy.created_at, l(@spreadsheet_copy.created_at, format: :spreadsheet_copy, locale: :es) %>.</p>
    <div class="page__links">
      <%= link_to "Ver copias del spreadsheet", spreadsheet_copies_path, class: "link" %>
      <%= link_to "Versión para imprimir", spreadsheet_copy_printout_path(@spreadsheet_copy, day: @selected_day, row_type: @selected_row_type), class: "link" %>
    </div>
  </header>

  <div class="toolbar">
    <nav class="tabs" aria-label="Días del programa actualizado">
      <% @days.each do |day| %>
        <%= link_to day, spreadsheet_copy_day_path(@spreadsheet_copy, day, row_type: @selected_row_type),
              class: "tabs__item#{' tabs__item--active' if day == @selected_day}",
              aria: { current: ("page" if day == @selected_day) } %>
      <% end %>
    </nav>

    <%= form_with url: spreadsheet_copy_day_path(@spreadsheet_copy, @selected_day), method: :get,
          class: "filter", data: { controller: "schedule-filter" } do %>
      <%= label_tag :row_type, "Tipo de actividad", class: "visually-hidden" %>
      <%= select_tag :row_type,
            options_for_select([["Todo", ""], ["Actos", "acts"], ["Preparaciones", "preparations"], ["Actividades previas", "prior_activities"]], @selected_row_type),
            data: { action: "change->schedule-filter#submit" } %>
      <%= submit_tag "Filtrar", data: { schedule_filter_target: "submit" } %>
    <% end %>
  </div>

  <div class="table-container">
    <table class="table">
      <caption class="visually-hidden">Programa de actividades para <%= @selected_day %></caption>
      <thead>
        <tr>
          <th scope="col">Horario</th>
          <th scope="col">Acto</th>
          <th scope="col">Actividad</th>
          <th scope="col"><span class="visually-hidden">Detalle</span></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <% if entry.is_a?(SpreadsheetCopy::PriorActivity) %>
            <tr class="schedule__prior-activity">
              <td class="text-nowrap"><%= entry.schedule.to_s.presence || "—" %></td>
              <td class="text-nowrap">—</td>
              <td class="schedule__activity"><strong>Actividad previa</strong> · <%= entry.title %></td>
              <td><%= link_to "Ver detalle", spreadsheet_copy_day_prior_activity_path(@spreadsheet_copy, entry.day, entry, row_type: @selected_row_type), class: "schedule__resources-link" %></td>
            </tr>
          <% elsif entry.is_a?(SpreadsheetCopy::Preparation) %>
            <tr class="schedule__preparation">
              <td class="text-nowrap"><%= entry.schedule.to_s.presence || "—" %></td>
              <td class="text-nowrap"><%= entry.act_number.presence || "—" %></td>
              <td class="schedule__activity"><strong>Preparación</strong> · <%= entry.title %></td>
              <td><%= link_to "Ver detalle", spreadsheet_copy_day_preparation_path(@spreadsheet_copy, entry.day, entry, row_type: @selected_row_type), class: "schedule__resources-link" %></td>
            </tr>
          <% else %>
            <tr>
              <td class="text-nowrap"><%= entry.schedule.to_s.presence || "—" %></td>
              <td class="text-nowrap"><%= entry.number || "—" %></td>
              <td class="schedule__activity">
                <%= entry.title %>
                <% document_count = @document_counts.fetch(entry.source_key, 0) %>
                <% if document_count.positive? %>
                  <span class="schedule__document-count" role="img" aria-label="<%= pluralize(document_count, "documento", "documentos") %>" title="<%= pluralize(document_count, "documento", "documentos") %>">
                    <%= render "icons/attachment" %>
                    <span aria-hidden="true"><%= document_count %></span>
                  </span>
                <% end %>
              </td>
              <td><%= link_to "Ver detalle", spreadsheet_copy_day_act_path(@spreadsheet_copy, entry.day, entry, row_type: @selected_row_type), class: "schedule__resources-link" %></td>
            </tr>
          <% end %>
        <% end %>
        <% if @entries.empty? %>
          <tr><td colspan="4">No hay actividades de este tipo para este día.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>
