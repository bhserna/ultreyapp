<% content_for :title, "Programa actualizado" %>

<main class="page page--wide">
  <header class="page__header page__header--flush">
    <h1>Programa actualizado</h1>
    <p>Copia descargada el <%= time_tag @spreadsheet_copy.created_at, l(@spreadsheet_copy.created_at, format: :spreadsheet_copy, locale: :es) %>.</p>
    <div class="page__links">
      <%= link_to "Ver copias del spreadsheet", spreadsheet_copies_path, class: "link" %>
      <%= link_to "Descargar para usar sin internet", spreadsheet_copy_offline_download_path(@spreadsheet_copy), class: "link", data: { turbo: false } %>
      <%= link_to "Versión para imprimir", spreadsheet_copy_printout_path(@spreadsheet_copy, day: @selected_day, row_type: @selected_row_type), class: "link" %>
    </div>
  </header>

  <div class="toolbar">
    <nav class="tabs" aria-label="Días del programa actualizado">
      <% @days.each do |day| %>
        <%= link_to day, spreadsheet_copy_day_path(@spreadsheet_copy, day, row_type: @selected_row_type),
              class: "tabs__item#{' tabs__item--active' if day == @selected_day}",
              aria: { current: ("page" if day == @selected_day) } %>
      <% end %>
    </nav>

    <%= form_with url: spreadsheet_copy_day_path(@spreadsheet_copy, @selected_day), method: :get,
          class: "filter", data: { controller: "schedule-filter" } do %>
      <%= label_tag :row_type, "Tipo de actividad", class: "visually-hidden" %>
      <%= select_tag :row_type,
            options_for_select([["Todo", ""], ["Actos", "acts"], ["Preparaciones", "preparations"], ["Actividades previas", "prior_activities"]], @selected_row_type),
            data: { action: "change->schedule-filter#submit" } %>
      <%= submit_tag "Filtrar", data: { schedule_filter_target: "submit" } %>
    <% end %>
  </div>

  <%= render "shared/spreadsheet_program_table", day: @selected_day, entries: @entries,
        entry_path: ->(entry) { spreadsheet_program_entry_path(@spreadsheet_copy, entry, row_type: @selected_row_type) },
        document_count: ->(entry) { @document_counts.fetch(entry.source_key, 0) } %>
</main>
