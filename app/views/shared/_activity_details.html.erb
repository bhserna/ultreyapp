<section class="page__section" aria-label="Detalles de la actividad" data-activity-id="<%= activity.id %>">
  <h2>Detalles de la actividad</h2>

  <% if (detail = activity.activity_detail) %>
    <% activity_detail_fields.each do |attribute, label| %>
      <% if detail.public_send(attribute).present? %>
        <h3><%= label %></h3>
        <%= simple_format(detail.public_send(attribute)) %>
      <% end %>
    <% end %>
    <div class="questions__actions">
      <%= link_to "Editar detalles", edit_activity_activity_detail_path(activity) %>
    </div>
  <% else %>
    <p>Todavía no hay detalles para esta actividad.</p>
    <%= link_to "Agregar detalles", new_activity_activity_detail_path(activity), class: "page__action" %>
  <% end %>
</section>
