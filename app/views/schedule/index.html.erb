<% content_for :title, "Programa Ultreya 2026" %>

<main class="page page--wide">
  <header class="page__header page__header--flush">
    <h1>Programa</h1>
  </header>

  <div class="toolbar">
    <nav class="tabs" aria-label="Días del programa">
      <% @schedule.days.each do |day| %>
        <%= link_to day, root_path(day: day, commission: @schedule.selected_commission),
              class: "tabs__item#{' tabs__item--active' if day == @schedule.selected_day}",
              aria: { current: ("page" if day == @schedule.selected_day) } %>
      <% end %>
    </nav>

    <%= form_with url: root_path, method: :get, class: "filter",
          data: { controller: "schedule-filter" } do %>
      <%= hidden_field_tag :day, @schedule.selected_day %>
      <%= label_tag :commission, "Comisión", class: "visually-hidden" %>
      <%= select_tag :commission,
            options_for_select([["Todas las comisiones", ""]] + @schedule.commissions.map { |commission| [commission, commission] }, @schedule.selected_commission),
            data: { action: "change->schedule-filter#submit" } %>
      <%= submit_tag "Filtrar", data: { schedule_filter_target: "submit" } %>
    <% end %>
  </div>

  <div class="table-container">
    <table class="table">
      <caption class="visually-hidden">Programa de actividades para <%= @schedule.selected_day %></caption>
      <thead>
        <tr>
          <th scope="col">Acto</th>
          <th scope="col">Hora Inicio</th>
          <th scope="col">Hora Fin</th>
          <th scope="col">Duración</th>
          <th scope="col">Actividad</th>
          <th scope="col">Comisión</th>
          <th scope="col"><span class="visually-hidden">Preguntas y documentos</span></th>
        </tr>
      </thead>
      <tbody>
        <% @schedule.entries.each do |schedule_entry| %>
          <tr>
            <td class="text-nowrap"><%= schedule_entry.act_number || "—" %></td>
            <td class="text-nowrap"><%= schedule_entry.start_time.presence || "—" %></td>
            <td class="text-nowrap"><%= schedule_entry.end_time.presence || "—" %></td>
            <td class="text-nowrap"><%= schedule_entry.duration.presence || "—" %></td>
            <td class="schedule__activity"><%= schedule_entry.activity %></td>
            <td><%= commission_links(schedule_entry) %></td>
            <td>
              <% resource_counts = @schedule.resource_counts.fetch(schedule_entry.id) %>
              <%= link_to "Preguntas y documentos", schedule_entry_path(schedule_entry.id), class: "schedule__resources-link" %>
              <small class="schedule__resource-status">
                Preguntas <%= resource_counts[:questions] %> ·
                Contestadas <%= resource_counts[:answered] %> ·
                Documentos <%= resource_counts[:documents] %>
              </small>
            </td>
          </tr>
        <% end %>
        <% if @schedule.entries.empty? %>
          <tr><td colspan="7">No hay actividades de esta comisión para <%= @schedule.selected_day %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>
