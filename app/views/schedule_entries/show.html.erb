<% content_for :title, @activity.title %>

<main class="page">
  <%= link_to "← Volver al programa", root_path(day: @activity.day), class: "page__back" %>

  <header class="page__header">
    <p class="page__eyebrow"><%= @activity.day %></p>
    <h1><%= @activity.title %></h1>
    <dl class="page__details">
      <div><dt>Inicio</dt><dd><%= @activity.start_time.presence || "—" %></dd></div>
      <div><dt>Fin</dt><dd><%= @activity.end_time.presence || "—" %></dd></div>
      <div><dt>Duración</dt><dd><%= @activity.duration.presence || "—" %></dd></div>
      <div><dt>Comisiones</dt><dd><%= commission_links(@activity) %></dd></div>
    </dl>
  </header>

  <%= render "shared/activity_details", activity: @activity %>

  <%= turbo_frame_tag "questions", src: schedule_entry_questions_path(@activity.id) do %>
    <p class="questions__empty">Cargando preguntas…</p>
  <% end %>

  <%= turbo_frame_tag "documents", src: schedule_entry_documents_path(@activity.id) do %>
    <p class="documents__empty">Cargando documentos…</p>
  <% end %>
</main>
