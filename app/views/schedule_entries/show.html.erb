<% content_for :title, "Preguntas y documentos · #{@schedule_entry.activity}" %>

<main class="activity-page">
  <%= link_to "← Volver al programa", root_path(day: @schedule_entry.day), class: "activity-page__back" %>

  <header class="activity-page__header">
    <p class="activity-page__eyebrow"><%= @schedule_entry.day %></p>
    <h1><%= @schedule_entry.activity %></h1>
    <dl class="activity-page__details">
      <div><dt>Inicio</dt><dd><%= @schedule_entry.start_time.presence || "—" %></dd></div>
      <div><dt>Fin</dt><dd><%= @schedule_entry.end_time.presence || "—" %></dd></div>
      <div><dt>Duración</dt><dd><%= @schedule_entry.duration.presence || "—" %></dd></div>
      <div><dt>Comisiones</dt><dd><%= commission_links(@schedule_entry) %></dd></div>
    </dl>
  </header>

  <%= turbo_frame_tag "questions", src: schedule_entry_questions_path(@schedule_entry.id) do %>
    <p class="questions__empty">Cargando preguntas…</p>
  <% end %>

  <%= turbo_frame_tag "documents", src: schedule_entry_documents_path(@schedule_entry.id) do %>
    <p class="documents__empty">Cargando documentos…</p>
  <% end %>
</main>
