<% content_for :title, "Documentos · #{@activity.title}" %>

<main class="page">
  <%= link_to "← Volver a la actividad", schedule_entry_path(@activity.id), class: "page__back" %>

  <header class="page__header">
    <p class="page__eyebrow"><%= @activity.day %></p>
    <h1><%= @activity.title %></h1>
  </header>

  <%= render "documents/collection", documents: @documents, unavailable_message: nil,
        upload_path: schedule_entry_documents_path(@activity.id),
        destroy_path: ->(document) { schedule_entry_document_path(@activity.id, document) } %>
</main>
