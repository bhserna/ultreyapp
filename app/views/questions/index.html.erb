<% content_for :title, @activity ? "Preguntas · #{@activity.title}" : "Preguntas generales" %>

<main class="page<%= " page--wide" unless @activity %>">
  <% if @activity %>
    <%= link_to "← Volver a la actividad", schedule_entry_path(@activity.id), class: "page__back" %>
  <% end %>

  <header class="page__header">
    <% if @activity %>
      <p class="page__eyebrow"><%= @activity.day %></p>
    <% end %>
    <h1><%= @activity ? @activity.title : "Preguntas generales" %></h1>
  </header>

  <div class="<%= "questions-layout" unless @activity %>">
  <% unless @activity %>
    <aside class="topics" aria-labelledby="topics-heading">
      <div class="topics__header">
        <h2 id="topics-heading">Temas</h2>
        <%= link_to "Editar", topics_path %>
      </div>
      <nav aria-label="Temas de preguntas">
        <ul class="topics__list">
          <li><%= link_to "Sin tema", questions_path, class: "topics__tab", aria: { current: ("page" unless @topic) } %></li>
          <% @topics.each do |topic| %>
            <li>
              <%= link_to topic.name, questions_path(topic_id: topic.id), class: "topics__tab", aria: { current: ("page" if @topic == topic) } %>
            </li>
          <% end %>
        </ul>
      </nav>
    </aside>
  <% end %>

  <%= turbo_frame_tag "questions" do %>
    <section class="page__section" aria-labelledby="questions-heading">
      <h2 id="questions-heading">Preguntas</h2>

      <% if @questions.any? %>
        <ul class="questions__list">
          <%= render @questions %>
        </ul>
      <% else %>
        <p class="questions__empty"><%= @activity ? "Todavía no hay preguntas para esta actividad." : (@topic ? "Todavía no hay preguntas para este tema." : "Todavía no hay preguntas generales sin tema.") %></p>
      <% end %>

      <div class="questions__new" data-controller="form-toggle">
        <button type="button" class="questions__new-button" data-action="form-toggle#show"
                data-form-toggle-target="trigger" aria-controls="new-question-form"
                aria-expanded="false">
          Nueva pregunta
        </button>

        <div id="new-question-form" class="questions__new-form" data-form-toggle-target="panel" hidden>
          <%= render "form", question: @question,
                url: questions_collection_path(activity: @activity, topic: @topic), method: :post,
                submit_label: "Guardar pregunta", cancel_action: "form-toggle#hide" %>
        </div>
      </div>
    </section>
  <% end %>
  </div>
</main>
