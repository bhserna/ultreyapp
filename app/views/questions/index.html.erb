<% content_for :title, @schedule_entry ? "Preguntas · #{@schedule_entry.activity}" : "Preguntas generales" %>

<main class="activity-page">
  <% if @schedule_entry %>
    <%= link_to "← Volver a la actividad", schedule_entry_path(@schedule_entry.id), class: "activity-page__back" %>
  <% end %>

  <header class="activity-page__header">
    <% if @schedule_entry %>
      <p class="activity-page__eyebrow"><%= @schedule_entry.day %></p>
    <% end %>
    <h1><%= @schedule_entry ? @schedule_entry.activity : "Preguntas generales" %></h1>
  </header>

  <%= turbo_frame_tag "questions" do %>
    <section class="activity-page__section" aria-labelledby="questions-heading">
      <h2 id="questions-heading">Preguntas</h2>

      <% if @questions.any? %>
        <ul class="questions__list">
          <% @questions.each do |question| %>
            <li class="questions__item">
              <%= turbo_frame_tag dom_id(question) do %>
                <p class="questions__body"><%= question.body %></p>
                <% if question.answer.present? %>
                  <div class="questions__answer"><%= simple_format(question.answer) %></div>
                <% end %>
                <div class="questions__actions">
                  <%= link_to "Editar", edit_question_path(question) %>
                  <%= link_to question.answer.present? ? "Editar respuesta" : "Responder",
                        edit_question_answer_path(question) %>
                  <%= button_to "Eliminar", question_path(question), method: :delete,
                        form: { data: { turbo_confirm: "¿Eliminar esta pregunta?", turbo_frame: "questions" } },
                        class: "activity-page__action" %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="questions__empty"><%= @schedule_entry ? "Todavía no hay preguntas para esta actividad." : "Todavía no hay preguntas generales." %></p>
      <% end %>

      <div class="questions__new" data-controller="question-form">
        <button type="button" class="questions__new-button" data-action="question-form#show"
                data-question-form-target="trigger" aria-controls="new-question-form"
                aria-expanded="false">
          Nueva pregunta
        </button>

        <div id="new-question-form" class="questions__new-form" data-question-form-target="panel" hidden>
          <%= render "form", question: @question,
                url: questions_path_maybe_for(@schedule_entry), method: :post,
                submit_label: "Guardar pregunta", cancel_action: "question-form#hide" %>
        </div>
      </div>
    </section>
  <% end %>
</main>
