<% content_for :title, @schedule_entry ? "Editar pregunta · #{@schedule_entry.activity}" : "Editar pregunta general" %>

<main class="activity-page">
  <%= link_to "← Volver a las preguntas", questions_collection_path(schedule_entry: @schedule_entry, topic: @question.topic), class: "activity-page__back" %>

  <header class="activity-page__header">
    <% if @schedule_entry %>
      <p class="activity-page__eyebrow"><%= @schedule_entry.day %> · <%= @schedule_entry.activity %></p>
    <% end %>
    <h1>Editar pregunta</h1>
  </header>

  <section class="activity-page__section">
    <%= turbo_frame_tag dom_id(@question) do %>
      <%= render "form", question: @question,
            url: question_path(@question), method: :patch,
            submit_label: "Guardar cambios", cancel_url: questions_collection_path(schedule_entry: @schedule_entry, topic: @question.topic) %>
    <% end %>
  </section>
</main>
