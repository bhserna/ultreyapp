<% content_for :title, @activity ? "Editar pregunta · #{@activity.title}" : "Editar pregunta general" %>

<main class="page">
  <%= link_to "← Volver a las preguntas", questions_collection_path(activity: @activity, topic: @question.topic), class: "page__back" %>

  <header class="page__header">
    <% if @activity %>
      <p class="page__eyebrow"><%= @activity.day %> · <%= @activity.title %></p>
    <% end %>
    <h1>Editar pregunta</h1>
  </header>

  <section class="page__section">
    <%= turbo_frame_tag dom_id(@question) do %>
      <%= render "form", question: @question,
            url: question_path(@question), method: :patch,
            submit_label: "Guardar cambios", cancel_url: questions_collection_path(activity: @activity, topic: @question.topic) %>
    <% end %>
  </section>
</main>
