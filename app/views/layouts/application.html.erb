<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ultreyapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ultreyapp">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "base", "site_nav", "activity_page", "commission_links", "schedule", "questions", "topics", "documents", "flash", "utilities", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% general_questions_page = %w[questions answers topics].include?(controller_name) && @schedule_entry.nil? %>
    <nav class="site-nav" aria-label="Navegación principal">
      <%= link_to "Programa", root_path, aria: { current: ("page" unless general_questions_page) } %>
      <%= link_to "Preguntas generales", questions_path, aria: { current: ("page" if general_questions_page) } %>
    </nav>

    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div class="flash flash--<%= type == "alert" ? "alert" : "notice" %>" role="<%= type == "alert" ? "alert" : "status" %>">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
